   "tokens": [
    "<sp(20)>",
    "<ab(4000)>"
   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>回避操作を行うと、姿を消した状態で\n回避を行います。<ab(4000)>",
   "en": "",
   "notes": ""
  },
  {
