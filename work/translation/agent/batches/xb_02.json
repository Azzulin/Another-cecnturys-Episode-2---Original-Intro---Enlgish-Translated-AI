   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>武器の軌道上にいる敵にもダメージを\n与えることが可能です。<ab(4000)>",
   "en": "",
   "notes": ""
  },
  {
