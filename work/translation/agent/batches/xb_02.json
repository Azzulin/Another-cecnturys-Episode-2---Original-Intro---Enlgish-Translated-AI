   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>投げた武器は対象にヒットすると\n手元に戻ってきますが、<ab(1000)>",
   "en": "",
   "notes": ""
  },
  {
   "ref": "m6302#82",
   "layer": "mission dialogue",
