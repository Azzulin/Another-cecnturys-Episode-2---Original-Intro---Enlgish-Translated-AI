   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>連続で行うとバーニア消費が大きくなるので\n注意しましょう。<ab(4000)><ed()>",
   "en": "",
   "notes": ""
  },
  {
