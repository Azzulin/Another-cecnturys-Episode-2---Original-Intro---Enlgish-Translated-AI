   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>アーマーが低下した時に使用しましょう。\n<ab(4000)><ed()>",
   "en": "",
   "notes": ""
  },
  {
