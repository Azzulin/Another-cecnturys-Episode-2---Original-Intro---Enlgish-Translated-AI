   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>展開中には移動することも可能です。\n強襲を仕掛ける際などに利用しましょう。<ab(4000)>",
   "en": "",
   "notes": ""
  },
  {
