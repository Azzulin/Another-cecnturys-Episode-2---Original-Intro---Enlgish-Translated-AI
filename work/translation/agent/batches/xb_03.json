   "tokens": [
    "<sp(20)>",
    "<ab(4000)>"
   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>リーンの翼はユニットの周囲に展開して\nバリアとして使用することが可能です。<ab(4000)>",
   "en": "",
   "notes": ""
  },
  {
   "ref": "m6302#165",
