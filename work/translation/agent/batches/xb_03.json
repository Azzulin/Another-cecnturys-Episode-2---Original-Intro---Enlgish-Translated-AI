   "tokens": [
    "<sp(20)>",
    "<ab(4000)>",
    "<ed()>"
   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>強力な攻撃を受けた時や、特定の攻撃を\n行った時には、強制的に解除されます。<ab(4000)><ed()>",
   "en": "",
   "notes": ""
  },
  {
