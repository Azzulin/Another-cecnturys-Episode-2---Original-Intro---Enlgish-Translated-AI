   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>Ｉフィールドは、強力な磁場を発生させ、\nビーム攻撃を無効化させるバリアです。<ab(4000)>",
   "en": "",
   "notes": ""
