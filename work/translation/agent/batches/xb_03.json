   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>リーンの翼を使った各種ウェポンが\n使用可能になります。<ab(4000)><ed()>",
   "en": "",
   "notes": ""
  },
  {
