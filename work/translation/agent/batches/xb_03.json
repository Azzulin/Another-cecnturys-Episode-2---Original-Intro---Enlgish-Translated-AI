   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>使用するタイミングを見極めて\n有効に活用してください。<ab(4000)><ed()>",
   "en": "",
   "notes": ""
  },
  {
