   "phase": null,
   "opens_new_window": false,
   "tokens": [
    "<sp(20)>",
    "<ab(4000)>"
   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>発動ボタンを押すことで、任意に\nＯＮ／ＯＦＦを切り替えることが可能です。<ab(4000)>",
   "en": "",
   "notes": ""
  },
  {
