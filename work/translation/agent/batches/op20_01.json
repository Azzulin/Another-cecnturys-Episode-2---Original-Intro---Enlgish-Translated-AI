   "phase": null,
   "tokens": [],
   "jp_lines": 1,
   "max_lines": 1,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "マクロス防衛",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63019#5",
   "layer": "strategic briefing",
   "phase": null,
   "portrait": 37,
   "tokens": [
    "<op(37,1)>",
    "<sp(2)>",
    "<ac(19)>",
    "<im(1)>",
    "<im(2)>",
    "#c[F07141]",
