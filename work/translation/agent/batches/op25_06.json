  {
   "ref": "m6255#23",
   "layer": "mission dialogue",
   "jp": "<sp(20)>私たちの手で、\n全てを終わらせなくてはならないのです。<ab(800)><ed()>",
   "en": ""
  },
  {
   "ref": "m6255#24",
   "layer": "mission dialogue",
   "jp": "<op()><sp(20)>ここで決着をつけます！<ab(300)><ed()>",
   "en": ""
  },
  {
   "ref": "m6255#25",
   "layer": "mission dialogue",
   "jp": "<op()><sp(20)>どーんと決めちゃってください！<ab(300)><ed()>",
