  {
   "ref": "m6255#16",
   "layer": "mission dialogue",
   "jp": "<op()><sp(20)>全ての敵を蹴散らすのです。<ab(700)><ed()>",
   "en": ""
  },
  {
   "ref": "m6255#17",
   "layer": "mission dialogue",
   "jp": "<op()><sp(20)>勇、比瑪ちゃん！　そろそろお願い！<ab(500)><ed()>",
   "en": ""
