   "max_line_chars_approx": 43,
   "jp": "<sp(0)>「ギガノス政変について」\n\n　　　　　　　　　　　　　　　　　　　　　　　　　　ＵＣＥ諜報部",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63228#1",
   "layer": "Preventer report",
   "phase": null,
   "tokens": [
    "<sp(0)>",
    "<im(1)>",
    "#c[BE5050]",
