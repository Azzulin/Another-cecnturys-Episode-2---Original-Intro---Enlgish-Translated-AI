   "jp_lines": 3,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<sp(0)>さらに同機には、何らかの自律制御システム\nが実装されており、出現のたびにその制御を\n最適化しているものと推定される。",
   "en": "",
   "notes": ""
  },
