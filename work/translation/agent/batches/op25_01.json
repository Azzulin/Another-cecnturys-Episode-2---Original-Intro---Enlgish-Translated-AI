    "#c[5E8FD8]",
    "#c"
   ],
   "jp_lines": 2,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(31,1)><sp(2)>一方で、#c[5E8FD8]ノヴィス･ノア#cのほうでも\n奇妙な事件がありました。",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63024#16",
   "layer": "strategic briefing",
   "phase": null,
   "portrait": 31,
   "tokens": [
    "<op(31,1)>",
    "<sp(2)>"
   ],
   "jp_lines": 2,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(31,1)><sp(2)>ブレンたちが勝手に動き出し、\nオルファンへの道を開いたのです。",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63024#17",
   "layer": "strategic briefing",
   "phase": null,
   "portrait": 31,
   "tokens": [
    "<op(31,1)>",
    "<sp(2)>"
   ],
   "jp_lines": 3,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(31,1)><sp(2)>比瑪ちゃんはこれを見て、\nブレンたちとオルファンは\n心を通じ合わせているのではないか…",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63024#18",
   "layer": "strategic briefing",
   "phase": null,
   "portrait": 31,
   "tokens": [
    "<op(31,1)>",
    "<sp(2)>"
   ],
   "jp_lines": 3,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(31,1)><sp(2)>そして、それと同じように人間にも\nオルファンを説得できるのではないかと\n考えたようです。",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63024#19",
   "layer": "strategic briefing",
   "phase": null,
   "portrait": 31,
   "tokens": [
    "<op(31,1)>",
    "<sp(2)>"
   ],
   "jp_lines": 3,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(31,1)><sp(2)>彼女と勇で、オルファンの説得を試みて\nもらおうと思います。\nオルファンは、必ず理解してくれます。",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63024#20",
   "layer": "strategic briefing",
   "phase": null,
   "portrait": 37,
   "tokens": [
    "<op(37,1)>",
