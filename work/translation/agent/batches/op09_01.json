   "jp_lines": 2,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(33,1)><sp(2)>今後ともよろしく頼むぞ。\n<im(1)>では、早速だが最初の任務だ。",
   "en": "",
   "notes": ""
