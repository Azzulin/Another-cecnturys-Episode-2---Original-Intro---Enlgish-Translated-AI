   "jp_lines": 2,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(33,1)><sp(2)>まずは#c[BE5050]デラーズ・フリート#c事件の\n事後処理について説明しておこう。",
   "en": "",
   "notes": ""
  },
  {
