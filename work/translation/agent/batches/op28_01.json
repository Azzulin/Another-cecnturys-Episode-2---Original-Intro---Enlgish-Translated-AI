   ],
   "jp_lines": 1,
   "max_lines": 2,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(37,1)><sp(2)>我々は、これに託そう。",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63027#29",
   "layer": "strategic briefing",
   "phase": null,
   "portrait": 37,
   "tokens": [
