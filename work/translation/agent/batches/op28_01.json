    "#c"
   ],
   "jp_lines": 2,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(37,1)><sp(2)>#c[BE5050]ゼントラーディ#cは、#c[BE5050]メルトランディ#cともども\n地球を壊滅させるつもりのようだ。",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63027#10",
   "layer": "strategic briefing",
   "phase": null,
   "portrait": 37,
   "tokens": [
    "<op(37,1)>",
