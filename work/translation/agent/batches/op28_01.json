   ],
   "jp_lines": 2,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(37,1)><sp(2)><im(2)>これが最<im(1)>後の戦い<im(3)>になるだろう。\nどのような結果になろうとも。",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63027#11",
   "layer": "strategic briefing",
   "phase": null,
   "portrait": 37,
   "tokens": [
    "<op(37,1)>",
