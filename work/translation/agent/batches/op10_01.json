   ],
   "jp_lines": 2,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(33,1)><sp(2)>このネルガル重工が、\n困ったことをしでかしてくれた。",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63009#9",
