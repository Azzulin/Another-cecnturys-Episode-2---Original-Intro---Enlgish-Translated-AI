   ],
   "jp_lines": 3,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(56,1)><sp(2)>合流予定の#c[5E8FD8]ドラグナー隊#cが先行して\n攻撃を始めているので、\n協力して作戦に当たってください。",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63033#8",
   "layer": "tactical briefing",
