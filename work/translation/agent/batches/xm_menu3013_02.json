   "jp_lines": 1,
   "max_lines": 1,
   "max_line_px": 568,
   "max_line_chars_approx": 56,
   "jp": "㌔ユニット強化",
   "en": "",
   "notes": ""
  },
  {
   "ref": "menu3013#104",
