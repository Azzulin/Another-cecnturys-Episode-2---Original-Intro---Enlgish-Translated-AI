   "phase": null,
   "opens_new_window": false,
   "tokens": [
    "<sp(20)>",
    "<ab(4000)>"
   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>グライダーは、一定の速度でユニットが\n自動前進する機能です。<ab(4000)>",
   "en": "",
   "notes": ""
  },
  {
