   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>特徴としては、ダッシュ中に高速の\n上昇・下降が可能なことが挙げられます。<ab(4000)>",
   "en": "",
   "notes": ""
