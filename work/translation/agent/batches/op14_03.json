   ],
   "jp_lines": 3,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<sp(0)>この理想を実現するため、\n私は長年準備してきたかねてよりの計画を\n実行に移します。",
   "en": "",
   "notes": ""
  },
  {
