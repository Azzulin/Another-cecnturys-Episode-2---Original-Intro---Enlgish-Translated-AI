   ],
   "jp_lines": 3,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<sp(0)>人類の未来は、優れた知性を持ち、\n心より地球を愛する者、\n私欲を廃し、人類の将来のみを考える、",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63248#17",
   "layer": "Preventer report",
   "phase": null,
   "tokens": [
