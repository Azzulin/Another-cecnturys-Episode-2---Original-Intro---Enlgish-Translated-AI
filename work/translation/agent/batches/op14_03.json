   ],
   "jp_lines": 3,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<sp(0)>優秀な人物の手に託されるべきです。\n\n",
   "en": "",
   "notes": ""
  },
  {
   "ref": "brief63248#18",
   "layer": "Preventer report",
   "phase": null,
   "tokens": [
