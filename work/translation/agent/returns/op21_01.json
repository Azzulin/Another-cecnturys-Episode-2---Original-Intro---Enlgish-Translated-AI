   "jp_lines": 2,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(41,1)><sp(2)>すみやかに全機出撃し、\n#c[F07141]敵艦隊を迎撃#cして欲しい。",
   "en": "<op(41,1)><sp(2)>Sortie all units promptly and\n#c[F07141]intercept the enemy fleet#c.",
   "notes": "Global sortie order."
  },
  {
