    "<ed()>"
   ],
   "jp_lines": 1,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>ある程度割り切りも必要さ。<ab(500)><ed()>",
   "en": "<sp(20)>You've gotta be a bit practical.<ab(500)><ed()>",
   "notes": "Min giving pragmatic advice."
