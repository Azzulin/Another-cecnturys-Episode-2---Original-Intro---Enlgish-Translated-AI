   "phase": 3,
   "opens_new_window": true,
   "tokens": [
    "<op()>",
    "<sp(20)>",
    "<ab(500)>",
    "<ed()>"
   ],
   "jp_lines": 1,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<op()><sp(20)>もうそんな恨みは忘れたね。<ab(500)><ed()>",
