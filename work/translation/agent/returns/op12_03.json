   "jp_lines": 1,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<op()><sp(20)>いいじゃないか、プラート大尉。<ab(400)>",
   "en": "<op()><sp(20)>What's the harm, Capt. Plato?<ab(400)>",
   "notes": "Min (Lee Sue Min) interjecting in casual tone."
  },
  {
   "ref": "m6123#19",
   "layer": "mission dialogue",
   "phase": 3,
   "opens_new_window": false,
   "tokens": [
