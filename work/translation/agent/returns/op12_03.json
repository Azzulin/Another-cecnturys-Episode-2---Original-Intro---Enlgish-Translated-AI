   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<op()><sp(20)>死にかけてたあたいを救ってくれたあんたに\nこんな説教めいたことを言いたかないけど。<ab(700)><ed()>",
