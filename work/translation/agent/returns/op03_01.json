   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>次は必ずあんたを倒す！\nあんたはオルファンを傷つける！<ab(500)><ed()>",
   "en": "<sp(20)>Next time I will defeat you!\nYou would harm Orphan!<ab(500)><ed()>",
