   "opens_new_window": true,
   "tokens": [
    "<op()>",
    "<sp(20)>",
    "<ab(400)>"
   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<op()><sp(20)>味方がやられた…！　手強い…！\nここは分が悪い…<ab(400)>",
   "en": "<op()><sp(20)>An ally was taken down...! Tough...!\nThe odds are against us here...<ab(400)>",
   "notes": "Enemy Reclaimer retreat line."
