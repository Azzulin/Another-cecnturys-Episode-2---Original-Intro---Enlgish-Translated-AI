   "layer": "mission dialogue",
   "phase": 1,
   "opens_new_window": true,
   "tokens": [
    "<op()>",
    "<sp(20)>",
    "<ab(300)>"
   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<op()><sp(20)>くっ…覚えておきなさい、勇！\n次は必ずあんたを倒す！<ab(300)>",
   "en": "<op()><sp(20)>Ugh... Remember this, Yuu!\nNext time I will defeat you!<ab(300)>",
   "notes": "Quincy retreat line."
  },
  {
   "ref": "m6031#27",
   "layer": "mission dialogue",
   "phase": 1,
   "opens_new_window": false,
   "tokens": [
    "<sp(20)>",
    "<ab(500)>",
    "<ed()>"
   ],
   "jp_lines": 1,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>おまえはオルファンを傷つける！<ab(500)><ed()>",
   "en": "<sp(20)>You would harm Orphan!<ab(500)><ed()>",
   "notes": "Continuation of row 52."
  },
  {
   "ref": "m6031#28",
   "layer": "mission dialogue",
   "phase": 1,
   "opens_new_window": true,
   "tokens": [
    "<op()>",
    "<sp(20)>",
    "<ab(1000)>",
    "<ed()>"
   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<op()><sp(20)>姉さん…\n完全にオルファンの抗体になりきってる！<ab(1000)><ed()>",
   "en": "<op()><sp(20)>Sis... She's become a complete\nAntibody to Orphan!<ab(1000)><ed()>",
   "notes": "Yuu Isami on Quincy."
  },
  {
