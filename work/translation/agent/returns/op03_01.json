  {
   "ref": "m6031#24",
   "layer": "mission dialogue",
   "phase": 1,
   "opens_new_window": true,
   "tokens": [
    "<op()>",
    "<sp(20)>",
    "<ab(300)>"
   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<op()><sp(20)>うるさい！\nあんたなんか、もう弟じゃないんだよ！<ab(300)>",
   "en": "<op()><sp(20)>Shut up!\nYou're no brother of mine anymore!<ab(300)>",
   "notes": "Quincy Issa."
  },
  {
   "ref": "m6031#25",
   "layer": "mission dialogue",
   "phase": 1,
   "opens_new_window": false,
   "tokens": [
    "<sp(20)>",
    "<ab(500)>",
    "<ed()>"
   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>リクレイマーを裏切って、\nノヴィス・ノアに走った時からね！<ab(500)><ed()>",
   "en": "<sp(20)>Not since you betrayed the\nReclaimers and ran to Novis Noah!<ab(500)><ed()>",
   "notes": "Continuation of row 50."
