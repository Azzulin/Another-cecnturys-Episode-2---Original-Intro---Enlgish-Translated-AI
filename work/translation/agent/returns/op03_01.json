   "jp_lines": 2,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(31,1)><sp(2)>#c[5E8FD8]ノヴィス・ノア#cの艦長代理、\nアイリーン・キャリアーです。",
   "en": "<op(31,1)><sp(2)>I am Irene Carrier, acting captain\nof the #c[5E8FD8]Novis Noah#c.",
   "notes": "Irene Carrier speaks."
  },
  {
   "ref": "brief63002#16",
   "layer": "strategic briefing",
   "phase": null,
   "portrait": 31,
   "tokens": [
    "<op(31,1)>",
    "<sp(2)>",
