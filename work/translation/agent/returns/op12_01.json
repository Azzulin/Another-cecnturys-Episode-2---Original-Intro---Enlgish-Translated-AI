   "jp_lines": 2,
   "max_lines": 3,
   "max_line_px": 430,
   "max_line_chars_approx": 43,
   "jp": "<op(37,1)><sp(2)><im(4)>時間は限られているが…\nしばらくは様子を見る。",
   "en": "<op(37,1)><sp(2)><im(4)>Time is limited, but...\nwe will observe the situation for now.",
   "notes": "Captain Sinapus speaking."
  },
  {
   "ref": "brief63011#13",
   "layer": "strategic briefing",
   "phase": null,
   "portrait": 36,
   "tokens": [
