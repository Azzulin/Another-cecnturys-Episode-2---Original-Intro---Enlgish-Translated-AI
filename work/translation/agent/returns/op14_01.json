   "jp_lines": 1,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<op()><sp(20)>あたいらも人のことは言えないけどね。<ab(500)><ed()>",
   "en": "<op()><sp(20)>Though we're hardly ones to talk.<ab(500)><ed()>",
