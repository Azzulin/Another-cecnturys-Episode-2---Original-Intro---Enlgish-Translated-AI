   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>人類の未来は、優れた知性を持ち、\n心より人類の将来のみを考える、<ab(0)>",
   "en": "<sp(20)>Humanity's future must be placed\nin the hands of the brilliant,<ab(0)>",
   "notes": "Rainen broadcast continuation."
  },
  {
   "ref": "m6143#19",
   "layer": "mission dialogue",
   "phase": 3,
   "opens_new_window": false,
   "tokens": [
    "<sp(20)>",
