   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>私の主張を葬り去った者が\nその代償を支払う時がやってきたのです。<ab(600)>",
   "en": "<sp(20)>and buried my claims in the past,\nmust now pay the price.<ab(600)>",
   "notes": "Rainen broadcast continuation."
