   ],
   "jp_lines": 1,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>優秀な人物の手に託されるべきです。<ab(500)>",
   "en": "<sp(20)>who care solely for our tomorrow.<ab(500)>",
   "notes": "Rainen broadcast continuation."
  },
