   "jp_lines": 1,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>過去に私の警告を無視し、<ab(0)>",
   "en": "<sp(20)>Those who ignored my warnings,<ab(0)>",
   "notes": "Rainen broadcast continuation."
  },
  {
