   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>地球圏外からの破壊者が\n地球に迫りつつあります。<ab(500)>",
   "en": "<sp(20)>destroyers from beyond the Sphere\nare now closing in on Earth.<ab(500)>",
