   "jp_lines": 1,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>この理想を実現するため、<ab(0)>",
   "en": "<sp(20)>To realize this ideal,<ab(0)>",
   "notes": "Rainen broadcast continuation."
  },
  {
   "ref": "m6143#21",
