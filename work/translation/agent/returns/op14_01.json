   "jp_lines": 1,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<op()><sp(20)>…どういうことだ？<ab(300)><ed()>",
   "en": "<op()><sp(20)>...What does this mean?<ab(300)><ed()>",
