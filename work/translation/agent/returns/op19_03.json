   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<op()><sp(20)>遠くからナデシコを\n狙っている艦がいるようね。<ab(300)>",
   "en": "<op()><sp(20)>There seems to be a ship sniping\nat the Nadesico from afar.<ab(300)>",
