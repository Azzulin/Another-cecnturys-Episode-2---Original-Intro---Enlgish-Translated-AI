   "tokens": [
    "<sp(20)>",
    "<ab(100)>"
   ],
   "jp_lines": 2,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>この遺跡はボソンジャンプの中央演算装置、\n手にした者は歴史を変える……<ab(100)>",
   "en": "<sp(20)>These ruins are the core CPU for\nBoson Jump. Whoever holds them...<ab(100)>",
   "notes": "Inez Fressange explaining significance of the ruins. fix: ; ausente na fonte -> trocado por ponto final."
  },
  {
   "ref": "m6193#9",
   "layer": "mission dialogue",
   "phase": 3,
   "opens_new_window": false,
   "tokens": [
    "<sp(20)>",
    "<ab(200)>",
    "<ed()>"
   ],
   "jp_lines": 1,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>となれば、当然かしら。<ab(200)><ed()>",
   "en": "<sp(20)>can alter history. Natural, I suppose.<ab(200)><ed()>",
   "notes": "Inez continuing reflection."
