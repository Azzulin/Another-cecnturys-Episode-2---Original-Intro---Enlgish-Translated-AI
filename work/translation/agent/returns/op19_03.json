   ],
   "jp_lines": 1,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<op()><sp(20)>敵も総力戦ね。<ab(200)>",
   "en": "<op()><sp(20)>The enemy's going all out, too.<ab(200)>",
   "notes": "Female pilot/officer noting enemy commitment."
