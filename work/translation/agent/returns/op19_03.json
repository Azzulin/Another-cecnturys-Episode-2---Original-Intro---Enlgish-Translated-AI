   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<op()><sp(20)>それでは作戦を説明します。<ab(200)>",
   "en": "<op()><sp(20)>Now, I'll explain our operation!<ab(200)>",
   "notes": "Yurika Misumaru."
