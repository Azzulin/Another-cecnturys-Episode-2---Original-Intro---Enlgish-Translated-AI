   ],
   "jp_lines": 1,
   "max_lines": 2,
   "max_line_px": 380,
   "max_line_chars_approx": 38,
   "jp": "<sp(20)>皆さんを信じてます！<ab(400)><ed()>",
   "en": "<sp(20)>I believe in all of you!<ab(400)><ed()>",
   "notes": "Yurika encouraging allies."
